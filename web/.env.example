# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time, so never put secrets in them.

# Base URL of the zagoat API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# development | production. Tags Sentry events.
NEXT_PUBLIC_ENVIRONMENT=development

# Monitoring and analytics stay off while these are empty.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
