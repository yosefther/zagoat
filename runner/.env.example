# Copy to runner/.env. Defaults work for local development with infra/docker-compose.yml.
# The runner must never hold database or payment credentials.

ENVIRONMENT=development

# Queue (the API's Redis) and where results go.
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000
# Must match WORKER_SECRET in api/.env.
WORKER_SECRET=dev-only-worker-secret

# Task images by the name used in problem.yaml. Production must pin by digest, e.g.
# IMAGES={"zagoat-py312-ml": "registry.example/zagoat-py312-ml@sha256:..."}
IMAGES={"zagoat-py312-ml": "zagoat-py312-ml:dev"}

# Jobs at once: about one per 2 GB of the runner's memory.
CONCURRENCY=3

# Tunables (see zagoat_runner/config.py for every value and its default):
# RUN_TIME_LIMIT_SECONDS=30
# SUBMIT_TIME_LIMIT_SECONDS=120
# MEMORY_LIMIT_MB=2048
# PIDS_LIMIT=64
# TMP_SIZE_MB=200
# OUTPUT_LIMIT_BYTES=65536
# MAX_QUEUE_AGE_SECONDS=300
