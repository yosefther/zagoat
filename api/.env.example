# Copy to api/.env. Defaults below match infra/docker-compose.yml for local development.
# Production must set DATABASE_URL, REDIS_URL, WEB_ORIGIN and SECRET_KEY explicitly, and
# COOKIE_SECURE=true, or the API won't start.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://zagoat:zagoat@localhost:5432/zagoat
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000

# Signs CSRF tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me

# Cookies. In production: COOKIE_DOMAIN=zagoat.io and COOKIE_SECURE=true.
# COOKIE_DOMAIN=
COOKIE_SECURE=false

# Error tracking stays off while this is empty.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Tunables (see api/app/config.py for every value and its default).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_CONNECT_TIMEOUT_SECONDS=5
# HEALTHCHECK_TIMEOUT_SECONDS=2.0
# IP_ATTEMPTS_PER_HOUR=5

# Used only by the test suite.
# TEST_DATABASE_URL=postgresql+psycopg://zagoat:zagoat@localhost:5432/zagoat_test
# TEST_REDIS_URL=redis://localhost:6379/15
