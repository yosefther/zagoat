# Copy to api/.env. Defaults below match infra/docker-compose.yml for local development.
# Production must set DATABASE_URL, REDIS_URL, WEB_ORIGIN and SECRET_KEY explicitly, and
# COOKIE_SECURE=true, or the API won't start.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://zagoat:zagoat@localhost:5432/zagoat
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000

# Signs CSRF tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me

# Public URL of this API (OAuth providers redirect back to it).
API_ORIGIN=http://localhost:8000

# OAuth apps. A provider shows up on the sign-in page only when both values are set.
# GitHub callback URL: <API_ORIGIN>/auth/github/callback
# Google callback URL: <API_ORIGIN>/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: adds "Continue as dev user" to the sign-in page.
# The API refuses to start with this enabled in production.
DEV_LOGIN_ENABLED=true

# Cookies. In production: COOKIE_DOMAIN=zagoat.io and COOKIE_SECURE=true.
# COOKIE_DOMAIN=
COOKIE_SECURE=false

# Error tracking stays off while this is empty.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Tunables (see api/app/config.py for every value and its default).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_CONNECT_TIMEOUT_SECONDS=5
# HEALTHCHECK_TIMEOUT_SECONDS=2.0
# IP_ATTEMPTS_PER_HOUR=5
# SESSION_LIFETIME_DAYS=30
# OAUTH_STATE_TTL_SECONDS=600

# Used only by the test suite.
# TEST_DATABASE_URL=postgresql+psycopg://zagoat:zagoat@localhost:5432/zagoat_test
# TEST_REDIS_URL=redis://localhost:6379/15

# Runner. WORKER_SECRET must match runner/.env; only these IPs may call /internal routes.
WORKER_SECRET=dev-only-worker-secret
WORKER_ALLOWED_IPS=["127.0.0.1", "::1"]

# Billing (section 10). "fake" works locally with fake checkout and portal pages; leave it
# empty in production until a real provider adapter exists.
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret
CURRENCY=USD
# Lifetime is not on sale until a price is set. Only the first LIFETIME_CAP are offered.
# LIFETIME_PRICE_CENTS=14900
# LIFETIME_CAP=100
# Off until the library has about 20 problems.
PRO_SUBSCRIPTIONS_ENABLED=false
# PRO_MONTHLY_PRICE_CENTS=1500
# PRO_YEARLY_PRICE_CENTS=9900
# PAST_DUE_GRACE_DAYS=7
# FREE_SUBMITS_PER_DAY=10
# PAID_SUBMITS_PER_DAY=100
# FREE_RUNS_PER_HOUR=30
# PAID_RUNS_PER_HOUR=120
